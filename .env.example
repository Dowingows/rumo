# Ollama (padrão, sem chave necessária)
RUMO_OLLAMA_URL=http://localhost:11434
RUMO_MODEL=qwen3:4b
RUMO_TEMPERATURE=0.1

# OpenCode Go (prioridade 1 — se definido, sobrepõe Groq e Ollama)
# Assine em https://opencode.ai/go ($5/mês)
# Modelos: kimi-k2.6, deepseek-v4-pro, qwen3.6-plus, glm-5.1
RUMO_OPENCODE_KEY=
RUMO_OPENCODE_MODEL=kimi-k2.6

# Groq API (prioridade 2 — se definido, sobrepõe Ollama)
# Crie sua chave gratuita em https://console.groq.com
RUMO_GROQ_KEY=
RUMO_GROQ_MODEL=llama3-8b-8192
